# ============================================================
# GhumneChalo Environment Variables Template (.env.example)
# Never put real credentials in this file.
# ============================================================

# Database (Supabase PostgreSQL / Direct connection for migrations)
DATABASE_URL=""
DIRECT_URL=""

# Authentication (Auth.js / NextAuth)
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
# Auth.js v5 canonical vars (required for local dev + self-hosted deployments)
AUTH_SECRET=""
AUTH_URL=""
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps Platform
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Gemini / Google Cloud Vertex AI
GCP_PROJECT_ID=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_MODEL="gemini-2.5-flash"
GCP_SERVICE_ACCOUNT_EMAIL=""
GCP_PRIVATE_KEY=""

# SMTP Email Service (NodeMailer)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Web Push / FCM (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@ghumnechalo.com"

# Cron Security (Vercel Cron Bearer secret)
CRON_SECRET=""

