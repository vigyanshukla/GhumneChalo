# ============================================================
# GhumneChalo — Production .gitignore
# Next.js 16 App Router + TypeScript + Prisma + Vercel + PWA
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert
*.crt
*service-account*.json
service.json
*.key.json

# Local Databases & Embedded Postgres
/.pgdata/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Logs & Debug Output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & Coverage
/coverage/
/.nyc_output/
acceptance-results.json
scratch-page.html
scratch/
test_*.png
*.screenshot.png
/p14b_screenshots/

# Vercel Deployment Cache
.vercel

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files & swap
*~
*.tmp
*.temp
